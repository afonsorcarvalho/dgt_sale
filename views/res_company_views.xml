<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_dgt_proposal" model="ir.ui.view">
        <field name="name">res.company.form.dgt.proposal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Proposta Comercial" name="dgt_proposal">
                    <group>
                        <group string="Identidade visual">
                            <field name="dgt_color_primary" placeholder="#RRGGBB"/>
                            <field name="dgt_color_accent" placeholder="#RRGGBB"/>
                            <field name="dgt_short_name" placeholder="Nome curto usado na proposta"/>
                        </group>
                    </group>
                    <group>
                        <field name="dgt_afe_anvisa"/>
                        <field name="dgt_bank_info"/>
                    </group>
                    <label for="dgt_proposal_letter"/>
                    <field name="dgt_proposal_letter"/>
                    <label for="dgt_proposal_differentials"/>
                    <field name="dgt_proposal_differentials"/>
                    <label for="dgt_public_declarations"/>
                    <field name="dgt_public_declarations"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
