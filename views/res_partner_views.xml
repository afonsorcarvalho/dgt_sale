<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_dgt_customer_type" model="ir.ui.view">
        <field name="name">res.partner.form.dgt.customer.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']/group" position="inside">
                <group string="Proposta comercial" name="dgt_proposal">
                    <field name="dgt_customer_type" widget="radio"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
