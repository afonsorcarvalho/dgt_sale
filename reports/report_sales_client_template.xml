<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cliente_equipment_template">
        <div class="dgt-card" style="border:1px solid #dfe2e5; border-radius:4px; overflow:hidden;">
            <div style="background:#2c3e50; color:#ffffff; padding:6px 12px; font-size:11px; font-weight:600; letter-spacing:.5px; text-transform:uppercase;">
                Dados do Cliente
            </div>
            <div style="padding:10px 12px; font-size:12px; line-height:1.5;">
                <div style="font-weight:700; font-size:13px; color:#2c3e50;">
                    <span t-field="doc.partner_id.name"/>
                </div>
                <div t-if="doc.partner_id.cnpj_cpf">
                    <span style="color:#6b7280;">CNPJ/CPF:</span>
                    <span t-field="doc.partner_id.cnpj_cpf"/>
                </div>
                <div>
                    <span t-field="doc.partner_id.street"/><t t-if="doc.partner_id.number">, <span t-field="doc.partner_id.number"/></t><t t-if="doc.partner_id.district">&#160;-&#160;<span t-field="doc.partner_id.district"/></t>
                </div>
                <div>
                    <span t-field="doc.partner_id.city_id.name"/><t t-if="doc.partner_id.state_id">&#160;-&#160;<span t-field="doc.partner_id.state_id.name"/></t><t t-if="doc.partner_id.zip">&#160;-&#160;CEP <span t-field="doc.partner_id.zip"/></t>
                </div>
                <div style="margin-top:4px; color:#374151;">
                    <t t-if="doc.partner_id.phone"><span t-field="doc.partner_id.phone"/></t><t t-if="doc.partner_id.mobile">&#160;&#160;/&#160;&#160;<span t-field="doc.partner_id.mobile"/></t>
                </div>
                <div t-if="doc.partner_id.email" style="color:#374151;">
                    <span t-field="doc.partner_id.email"/>
                </div>
            </div>
        </div>
    </template>
</odoo>
