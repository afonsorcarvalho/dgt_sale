<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="dgt_proposal_layout">
    <t t-if="not o" t-set="o" t-value="doc"/>
    <t t-if="not company" t-set="company" t-value="doc.company_id.sudo()"/>
    <t t-if="not pal" t-set="pal" t-value="company.dgt_proposal_palette()"/>

    <div class="header">
        <div t-att-class="'dgt-hdr' + (' dgt-hide-first' if has_cover else '')" style="font-family:Helvetica,Arial,sans-serif;">
            <table t-att-style="'width:100%; border-collapse:collapse; border-bottom:2px solid ' + pal['primary'] + ';'">
                <tr>
                    <td style="vertical-align:bottom; padding-bottom:6px;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height:40px;"/>
                    </td>
                    <td style="vertical-align:bottom; text-align:right; padding-bottom:6px; font-size:11px; color:#6b7280;">
                        <span t-att-style="'color:' + pal['accent'] + '; font-weight:700; letter-spacing:1.5px; font-size:10px;'">
                            <t t-if="is_quote">PROPOSTA COMERCIAL</t><t t-else="">PEDIDO DE VENDA</t>
                        </span><br/>
                        <span t-att-style="'font-weight:700; color:' + pal['primary'] + '; font-size:13px;'">Nº <t t-esc="doc.name"/></span>
                    </td>
                </tr>
            </table>
        </div>
        <script>
            (function () {
                var q = document.location.search.substring(1).split('&amp;');
                var v = {};
                for (var i = 0; i &lt; q.length; i++) {
                    var z = q[i].split('=', 2);
                    v[z[0]] = decodeURIComponent(z[1] || '');
                }
                if (v.sitepage === '1') {
                    var e = document.getElementsByClassName('dgt-hide-first');
                    for (var j = 0; j &lt; e.length; j++) { e[j].style.visibility = 'hidden'; }
                }
            })();
        </script>
    </div>

    <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
        <t t-raw="0"/>
    </div>

    <div class="footer">
        <div style="font-family:Helvetica,Arial,sans-serif; font-size:9px; color:#6b7280; border-top:1px solid #dfe2e5; padding-top:4px;">
            <table style="width:100%; border-collapse:collapse;">
                <tr>
                    <td>
                        <t t-esc="company.name"/>
                        <t t-if="company.partner_id.cnpj_cpf"> · CNPJ <t t-esc="company.partner_id.cnpj_cpf"/></t>
                        <t t-if="company.phone"> · <t t-esc="company.phone"/></t>
                        <t t-if="company.email"> · <t t-esc="company.email"/></t>
                    </td>
                    <td style="text-align:right; white-space:nowrap;">Página <span class="page"/> / <span class="topage"/></td>
                </tr>
            </table>
        </div>
    </div>
</template>
</odoo>
