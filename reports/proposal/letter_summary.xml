<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="dgt_proposal_letter_summary">
    <div t-att-style="'font-family:Helvetica,Arial,sans-serif; color:' + pal['primary'] + '; font-size:11px;'">
        <t t-set="cp" t-value="doc.partner_id.commercial_partner_id"/>
        <t t-set="contact" t-value="doc.partner_id if doc.partner_id.parent_id else False"/>
        <table style="width:100%; border-collapse:collapse; margin-bottom:12px;">
            <tr>
                <td style="vertical-align:top; width:70%; padding-right:12px;">
                    <div style="font-size:10px; color:#6b7280; text-transform:uppercase; letter-spacing:.6px; margin-bottom:4px;">Destinatário</div>
                    <div style="border:1px solid #dfe2e5; border-radius:8px;">
                        <table style="width:100%; border-collapse:collapse; font-size:10px;">
                            <tr>
                                <td style="width:50%; vertical-align:top; padding:8px 10px;">
                                    <div t-att-style="'font-size:13px; font-weight:700; color:' + pal['primary'] + ';'"><t t-esc="cp.legal_name or cp.name"/></div>
                                    <div t-if="cp.legal_name and cp.legal_name != cp.name" style="color:#6b7280; font-size:9px; margin-top:1px;">Nome fantasia: <t t-esc="cp.name"/></div>
                                    <div t-if="cp.cnpj_cpf or cp.inscr_est" style="margin-top:5px; color:#374151;">
                                        <t t-if="cp.cnpj_cpf">CNPJ/CPF <t t-esc="cp.cnpj_cpf"/></t><t t-if="cp.cnpj_cpf and cp.inscr_est"> · </t><t t-if="cp.inscr_est">IE <t t-esc="cp.inscr_est"/></t>
                                    </div>
                                    <div t-if="cp.street or cp.city_id or cp.city" style="margin-top:5px;">
                                        <div style="font-size:8.5px; color:#6b7280; text-transform:uppercase; letter-spacing:.5px;">Endereço</div>
                                        <div style="color:#374151;">
                                            <t t-if="cp.street">
                                                <t t-esc="cp.street"/><t t-if="cp.number">, <t t-esc="cp.number"/></t><t t-if="cp.street2"> - <t t-esc="cp.street2"/></t><br/>
                                            </t>
                                            <t t-if="cp.district"><t t-esc="cp.district"/><br/></t>
                                            <t t-if="cp.city_id or cp.city or cp.state_id or cp.zip">
                                                <t t-set="addr_city" t-value="cp.city_id.name or cp.city or ''"/>
                                                <t t-set="addr_has_prefix" t-value="bool(addr_city or cp.state_id)"/>
                                                <t t-if="addr_city"><t t-esc="addr_city"/></t>
                                                <t t-if="addr_city and cp.state_id"> / <t t-esc="cp.state_id.code"/></t>
                                                <t t-if="not addr_city and cp.state_id"><t t-esc="cp.state_id.code"/></t>
                                                <t t-if="cp.zip">
                                                    <t t-if="addr_has_prefix"> · CEP <t t-esc="cp.zip"/></t>
                                                    <t t-if="not addr_has_prefix">CEP <t t-esc="cp.zip"/></t>
                                                </t>
                                            </t>
                                        </div>
                                    </div>
                                </td>
                                <td style="width:50%; vertical-align:top; padding:8px 10px; border-left:1px solid #eef0f2;">
                                    <div t-if="cp.phone or cp.mobile">
                                        <div style="font-size:8.5px; color:#6b7280; text-transform:uppercase; letter-spacing:.5px;">Telefone</div>
                                        <div style="color:#374151;"><t t-esc="cp.phone or cp.mobile"/><t t-if="cp.phone and cp.mobile"> / <t t-esc="cp.mobile"/></t></div>
                                    </div>
                                    <div t-if="cp.email" style="margin-top:5px;">
                                        <div style="font-size:8.5px; color:#6b7280; text-transform:uppercase; letter-spacing:.5px;">E-mail</div>
                                        <div style="color:#374151;"><t t-esc="cp.email"/></div>
                                    </div>
                                    <div t-if="contact" style="margin-top:5px;">
                                        <div style="font-size:8.5px; color:#6b7280; text-transform:uppercase; letter-spacing:.5px;">Contato (A/C)</div>
                                        <div style="color:#374151;">
                                            <t t-esc="contact.name"/>
                                            <t t-if="contact.phone or contact.mobile"><br/><t t-esc="contact.phone or contact.mobile"/></t>
                                            <t t-if="contact.email"><br/><t t-esc="contact.email"/></t>
                                        </div>
                                    </div>
                                    <div t-if="is_public and doc.dgt_bid_ref" style="margin-top:5px;">
                                        <div style="font-size:8.5px; color:#6b7280; text-transform:uppercase; letter-spacing:.5px;">Ref.</div>
                                        <div style="color:#374151;"><t t-esc="doc.dgt_bid_ref"/></div>
                                    </div>
                                    <div t-if="doc.client_order_ref and not is_public" style="margin-top:5px;">
                                        <div style="font-size:8.5px; color:#6b7280; text-transform:uppercase; letter-spacing:.5px;">Sua referência</div>
                                        <div style="color:#374151;"><t t-esc="doc.client_order_ref"/></div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
                <td style="vertical-align:top; width:30%; text-align:right; color:#6b7280;">
                    <t t-set="dgt_company_city" t-value="company.partner_id.city_id.name or company.city or ''"/>
                    <t t-if="dgt_company_city"><t t-esc="dgt_company_city"/>, </t>
                    <span t-field="doc.date_order" t-options='{"widget": "date"}'/>
                </td>
            </tr>
        </table>

        <div t-if="company.dgt_proposal_letter" style="line-height:1.6; color:#374151; margin-bottom:16px;" t-raw="company.dgt_proposal_letter"/>

        <t t-call="dgt_sale.dgt_proposal_block_title"><t t-set="title" t-value="'Resumo do investimento'"/></t>
        <table style="width:100%; border-collapse:collapse; font-size:10.5px;">
            <tr t-att-style="'background:' + pal['primary_tint'] + '; color:#6b7280; font-size:9px; text-transform:uppercase; letter-spacing:.5px;'">
                <td style="padding:5px 6px; border-bottom:1px solid #dfe2e5; width:28px;">Item</td>
                <td style="padding:5px 6px; border-bottom:1px solid #dfe2e5;">Descrição</td>
                <td style="padding:5px 6px; border-bottom:1px solid #dfe2e5;">Marca / Modelo</td>
                <td style="padding:5px 6px; border-bottom:1px solid #dfe2e5; text-align:right;">Qtd.</td>
                <td style="padding:5px 6px; border-bottom:1px solid #dfe2e5; text-align:right;">Unit.</td>
                <td style="padding:5px 6px; border-bottom:1px solid #dfe2e5; text-align:right;">Total</td>
            </tr>
            <t t-set="item_no" t-value="0"/>
            <t t-foreach="doc.order_line" t-as="line">
                <t t-if="line.display_type == 'line_section'">
                    <tr>
                        <td colspan="6" t-att-style="'padding:6px; font-weight:700; color:' + pal['primary'] + '; border-bottom:1px solid #dfe2e5; background:#fbfbfc; text-transform:uppercase; font-size:9.5px; letter-spacing:.5px;'">
                            <t t-esc="line.name"/>
                        </td>
                    </tr>
                </t>
                <t t-if="not line.display_type">
                    <t t-set="item_no" t-value="item_no + 1"/>
                    <tr>
                        <td t-att-style="'padding:5px 6px; border-bottom:1px solid #eef0f2; color:' + pal['accent'] + '; font-weight:700;'"><t t-esc="'%02d' % item_no"/></td>
                        <td style="padding:5px 6px; border-bottom:1px solid #eef0f2; font-weight:600;"><t t-esc="line.product_id.name or line.name"/></td>
                        <td style="padding:5px 6px; border-bottom:1px solid #eef0f2; color:#374151;">
                            <t t-esc="line.product_id.dgt_brand or '—'"/><t t-if="line.product_id.dgt_model"> / <t t-esc="line.product_id.dgt_model"/></t>
                        </td>
                        <td style="padding:5px 6px; border-bottom:1px solid #eef0f2; text-align:right; white-space:nowrap;">
                            <t t-esc="('%g' % line.product_uom_qty).replace('.', ',')"/> <t t-esc="line.product_uom.name"/>
                        </td>
                        <td style="padding:5px 6px; border-bottom:1px solid #eef0f2; text-align:right; white-space:nowrap;">
                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": currency}'/>
                            <div t-if="line.discount" style="font-size:9px; color:#1d6b3a;">desc. <t t-esc="'%g' % line.discount"/>%</div>
                        </td>
                        <td style="padding:5px 6px; border-bottom:1px solid #eef0f2; text-align:right; white-space:nowrap; font-weight:700;">
                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </td>
                    </tr>
                </t>
            </t>
        </table>

        <table style="width:100%; border-collapse:collapse; margin-top:8px;">
            <tr>
                <td style="width:52%;"></td>
                <td style="width:48%;">
                    <table style="width:100%; border-collapse:collapse; font-size:11px;">
                        <tr>
                            <td style="padding:4px 10px; color:#6b7280;">Subtotal</td>
                            <td style="padding:4px 10px; text-align:right; font-weight:600;"><span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                        </tr>
                        <t t-foreach="doc.amount_by_group" t-as="amt">
                            <tr>
                                <td style="padding:4px 10px; color:#6b7280;"><t t-esc="amt[0]"/></td>
                                <td style="padding:4px 10px; text-align:right; font-weight:600;"><span t-esc="amt[1]" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                            </tr>
                        </t>
                    </table>
                    <div t-att-style="'border:1.5px solid ' + pal['primary'] + '; border-radius:6px; margin-top:6px;'">
                        <table t-att-style="'width:100%; border-collapse:collapse; color:' + pal['primary'] + ';'">
                            <tr>
                                <td style="padding:8px 10px; font-weight:700; letter-spacing:.5px;">VALOR TOTAL</td>
                                <td style="padding:8px 10px; text-align:right; font-weight:800; font-size:15px;"><span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>
        <div style="margin-top:6px; text-align:right; font-size:10.5px; color:#374151; font-style:italic;">
            (<t t-esc="doc.dgt_amount_total_text"/>)
        </div>
    </div>
</template>
</odoo>
