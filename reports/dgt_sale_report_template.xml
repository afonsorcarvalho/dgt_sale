<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="dgt_sale_report_template">
    <t t-call="web.html_container">
    <t t-foreach="docs" t-as="doc">
    <t t-call="web.external_layout">

        <t t-set="is_quote" t-value="doc.state in ['draft','sent']"/>
        <t t-set="currency" t-value="doc.pricelist_id.currency_id"/>
        <t t-set="display_discount" t-value="any([l.discount for l in doc.order_line])"/>

        <div class="page" style="font-size:12px; color:#2c3e50;">

            <!-- ============ CABEÇALHO ============ -->
            <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                <tr>
                    <td style="vertical-align:middle;">
                        <div style="font-size:11px; letter-spacing:2px; text-transform:uppercase; color:#e8730c; font-weight:700;">
                            <t t-if="env.context.get('proforma', False) or is_pro_forma">Informações de Fatura</t>
                            <t t-else="">
                                <t t-if="is_quote">Proposta Comercial</t>
                                <t t-else="">Pedido de Venda</t>
                            </t>
                        </div>
                        <div style="font-size:26px; font-weight:700; line-height:1.1;">
                            <t t-if="is_quote">Cotação</t><t t-else="">Pedido</t>
                            Nº <span t-field="doc.name"/>
                        </div>
                    </td>
                    <td style="vertical-align:middle; text-align:right;">
                        <div t-if="doc.date_order and is_quote" style="font-size:11px; color:#6b7280;">Data da cotação</div>
                        <div t-if="doc.date_order and is_quote" style="font-size:14px; font-weight:600;"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></div>
                        <div t-if="doc.confirmation_date and not is_quote" style="font-size:11px; color:#6b7280;">Data do pedido</div>
                        <div t-if="doc.confirmation_date and not is_quote" style="font-size:14px; font-weight:600;"><span t-field="doc.confirmation_date" t-options='{"widget": "date"}'/></div>
                    </td>
                </tr>
            </table>

            <!-- ============ CLIENTE + META ============ -->
            <table style="width:100%; border-collapse:separate; border-spacing:0; margin-bottom:18px;">
                <tr>
                    <td style="width:56%; vertical-align:top; padding-right:10px;">
                        <t t-call="dgt_sale.report_cliente_equipment_template"/>
                    </td>
                    <td style="width:44%; vertical-align:top;">
                        <table style="width:100%; border:1px solid #dfe2e5; border-radius:4px; border-collapse:collapse; font-size:12px;">
                            <tr t-if="doc.client_order_ref">
                                <td style="padding:5px 10px; color:#6b7280; border-bottom:1px solid #eef0f2;">Sua Referência</td>
                                <td style="padding:5px 10px; font-weight:600; text-align:right; border-bottom:1px solid #eef0f2;"><span t-field="doc.client_order_ref"/></td>
                            </tr>
                            <tr t-if="doc.user_id">
                                <td style="padding:5px 10px; color:#6b7280; border-bottom:1px solid #eef0f2;">Vendedor</td>
                                <td style="padding:5px 10px; font-weight:600; text-align:right; border-bottom:1px solid #eef0f2;"><span t-field="doc.user_id"/></td>
                            </tr>
                            <tr t-if="doc.payment_term_id">
                                <td style="padding:5px 10px; color:#6b7280; border-bottom:1px solid #eef0f2;">Pagamento</td>
                                <td style="padding:5px 10px; font-weight:600; text-align:right; border-bottom:1px solid #eef0f2;"><span t-field="doc.payment_term_id"/></td>
                            </tr>
                            <tr t-if="doc.validity_date and is_quote">
                                <td style="padding:5px 10px; color:#6b7280;">Validade</td>
                                <td style="padding:5px 10px; font-weight:600; text-align:right;"><span t-field="doc.validity_date" t-options='{"widget": "date"}'/></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ============ ITENS ============ -->
            <t t-set="counter" t-value="0"/>
            <t t-foreach="doc.order_line" t-as="line">

                <!-- Seção -->
                <t t-if="line.display_type == 'line_section'">
                    <div style="background:#2c3e50; color:#ffffff; padding:6px 12px; margin:14px 0 8px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; border-radius:3px;">
                        <span t-field="line.name"/>
                    </div>
                </t>

                <!-- Nota -->
                <t t-if="line.display_type == 'line_note'">
                    <div style="padding:2px 4px 8px; font-size:12px; font-style:italic; color:#6b7280;">
                        <span t-field="line.name"/>
                    </div>
                </t>

                <!-- Produto -->
                <t t-if="not line.display_type">
                    <t t-set="counter" t-value="counter + 1"/>
                    <table t-att-style="'width:100%; border:1px solid #dfe2e5; border-radius:4px; border-collapse:collapse; margin-bottom:10px; ' + ('page-break-inside:avoid;' if line.product_id.image else '')">
                        <!-- título do item -->
                        <tr>
                            <td colspan="2" style="background:#f5f6f7; border-bottom:1px solid #dfe2e5; padding:7px 12px;">
                                <table style="width:100%; border-collapse:collapse;">
                                    <tr>
                                        <td style="font-size:13px; font-weight:700; color:#2c3e50;">
                                            <span style="display:inline-block; min-width:22px; height:22px; line-height:22px; text-align:center; background:#e8730c; color:#fff; border-radius:50%; font-size:12px; margin-right:6px;"><t t-esc="counter"/></span>
                                            <span t-field="line.product_id.display_name"/>
                                        </td>
                                        <td style="text-align:right; white-space:nowrap; font-size:14px; font-weight:700; color:#2c3e50;">
                                            <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <!-- corpo: foto + detalhes -->
                        <tr>
                            <td t-if="line.product_id.image" style="width:190px; vertical-align:top; text-align:center; padding:12px; border-right:1px solid #eef0f2;">
                                <img style="max-width:165px; max-height:165px; border:1px solid #dfe2e5; border-radius:3px; padding:3px; background:#fff;" t-att-src="'data:image/png;base64,%s' % to_text(line.product_id.image)"/>
                                <div style="font-size:9px; color:#9aa0a6; margin-top:4px; text-transform:uppercase; letter-spacing:.5px;">Foto meramente ilustrativa</div>
                            </td>
                            <td style="vertical-align:top; padding:12px;">
                                <div t-if="line.name" style="font-size:12px; line-height:1.55; color:#374151; white-space:pre-line; margin-bottom:10px;"><t t-esc="line.name"/></div>
                                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                    <tr style="background:#f5f6f7; color:#6b7280; text-transform:uppercase; font-size:10px; letter-spacing:.5px;">
                                        <td style="padding:4px 8px; border:1px solid #eef0f2;">Qtd.</td>
                                        <td style="padding:4px 8px; border:1px solid #eef0f2; text-align:right;">Valor Unit.</td>
                                        <td t-if="display_discount" style="padding:4px 8px; border:1px solid #eef0f2; text-align:right;">Desc.</td>
                                        <td style="padding:4px 8px; border:1px solid #eef0f2; text-align:right;">Valor Total</td>
                                    </tr>
                                    <tr style="font-weight:600;">
                                        <td style="padding:6px 8px; border:1px solid #eef0f2;">
                                            <span t-field="line.product_uom_qty"/>
                                            <span t-field="line.product_uom" groups="uom.group_uom"/>
                                        </td>
                                        <td style="padding:6px 8px; border:1px solid #eef0f2; text-align:right;">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                        <td t-if="display_discount" style="padding:6px 8px; border:1px solid #eef0f2; text-align:right;">
                                            <t t-if="line.discount"><span t-field="line.discount"/>%</t><t t-else="">—</t>
                                        </td>
                                        <td style="padding:6px 8px; border:1px solid #eef0f2; text-align:right; color:#2c3e50;">
                                            <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </t>
            </t>

            <!-- ============ TOTAIS ============ -->
            <table style="width:100%; border-collapse:collapse; margin-top:6px;">
                <tr>
                    <td style="width:55%;"></td>
                    <td style="width:45%; vertical-align:top;">
                        <table style="width:100%; border:1px solid #dfe2e5; border-radius:4px; border-collapse:collapse; font-size:12px;">
                            <tr>
                                <td style="padding:6px 12px; color:#6b7280; border-bottom:1px solid #eef0f2;">Subtotal</td>
                                <td style="padding:6px 12px; text-align:right; font-weight:600; border-bottom:1px solid #eef0f2;"><span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                            </tr>
                            <t t-foreach="doc.amount_by_group" t-as="amt">
                                <tr>
                                    <td style="padding:6px 12px; color:#6b7280; border-bottom:1px solid #eef0f2;"><span t-esc="amt[0]"/></td>
                                    <td style="padding:6px 12px; text-align:right; font-weight:600; border-bottom:1px solid #eef0f2;"><span t-esc="amt[1]" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                </tr>
                            </t>
                            <tr style="background:#2c3e50; color:#ffffff;">
                                <td style="padding:9px 12px; font-weight:700; text-transform:uppercase; letter-spacing:.5px;">Valor Total</td>
                                <td style="padding:9px 12px; text-align:right; font-weight:700; font-size:15px;"><span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ============ OBSERVAÇÕES ============ -->
            <t t-if="doc.note or doc.payment_term_id.note or (doc.fiscal_position_id and doc.fiscal_position_id.sudo().note)">
                <div style="margin-top:16px; padding:10px 12px; background:#f9fafb; border:1px solid #eef0f2; border-radius:4px; font-size:11px; color:#374151; line-height:1.5;">
                    <div style="font-weight:700; text-transform:uppercase; font-size:10px; letter-spacing:.5px; color:#6b7280; margin-bottom:4px;">Observações</div>
                    <div t-if="doc.note" t-field="doc.note"/>
                    <div t-if="doc.payment_term_id.note"><span t-field="doc.payment_term_id.note"/></div>
                    <div t-if="doc.fiscal_position_id and doc.fiscal_position_id.sudo().note"><span t-field="doc.fiscal_position_id.sudo().note"/></div>
                </div>
            </t>

            <!-- ============ ASSINATURAS ============ -->
            <t t-call="dgt_sale.report_sales_assinatura_template"/>

            <div t-if="doc.signature" style="margin-top:16px; text-align:right;" name="signature">
                <div style="font-weight:600; font-size:12px;">Assinatura eletrônica</div>
                <img t-att-src="image_data_uri(doc.signature)" style="max-height:4cm; max-width:8cm;"/>
                <div style="font-size:12px;" t-field="doc.signed_by"/>
            </div>

        </div>
    </t>
    </t>
</t>
</template>
</odoo>
