<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_dgt_quotation" model="report.paperformat">
            <field name="name">DGT Cotação Vendas</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">52</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">47</field>
            <field name="dpi">120</field>
        </record>

        <report
            id="action_dgt_report_saleorder"
            string="Cotação Vendas"
            model="sale.order"
            report_type="qweb-pdf"
            file="dgt_sale.dgt_sale_report_template"
            name="dgt_sale.dgt_sale_report_template"
            print_report_name="(object.state in ('draft', 'sent') and 'Cotação - %s' % (object.name)) or 'Pedido - %s' % (object.name)"
            paperformat="paperformat_dgt_quotation"
        />


    </data>
</odoo>